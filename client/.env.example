# The Express API base URL. NEXT_PUBLIC_ prefix is required because this
# value is read from client components too (e.g. AnnouncementBar).
#
# Local dev note: Next's dev server and the Express API both default to
# port 3000. Run the API on a different port locally, e.g.:
#   PORT=4000 npm run dev   (inside server/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Shared secret for POST /api/revalidate — the Express API calls this
# endpoint after estate/branch/knowledge-base writes to invalidate ISR
# cache tags on demand (PRD FR-3). Must match REVALIDATE_SECRET in the
# server's .env. Generate with: openssl rand -hex 24
REVALIDATE_SECRET=
