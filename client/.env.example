# The Express API base URL. NEXT_PUBLIC_ prefix is required because this
# value is read from client components too (e.g. AnnouncementBar).
#
# Local dev note: Next's dev server and the Express API both default to
# port 3000. Run the API on a different port locally, e.g.:
#   PORT=4000 npm run dev   (inside server/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Shared secret for POST /api/revalidate — the Express API calls this
# endpoint after estate/branch/knowledge-base writes to invalidate ISR
# cache tags on demand (PRD FR-3). Must match REVALIDATE_SECRET in the
# server's .env. Generate with: openssl rand -hex 24
REVALIDATE_SECRET=

# ── Analytics & Search Console (PRD FR-6) ───────────────────────────────────
# GA4 measurement ID, e.g. "G-XXXXXXXXXX". GoogleAnalytics.tsx renders
# nothing until this is set — safe to leave blank until a GA4 property
# exists. Create one at analytics.google.com.
NEXT_PUBLIC_GA_ID=

# Search Console HTML tag verification token (Search Console → Settings →
# Ownership verification → HTML tag → copy just the content="..." value).
# Rendered into <meta name="google-site-verification"> in app/layout.tsx.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Observability ────────────────────────────────────────────────────────────
# Client-side (browser) Sentry DSN — used by src/lib/sentryClient.ts.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side (Node runtime / RSC) Sentry DSN for this app — used by
# src/instrumentation.ts. Can be the same Sentry project as
# NEXT_PUBLIC_SENTRY_DSN, but keep them as separate values here since
# instrumentation.ts reads this exact name, not the NEXT_PUBLIC_ one.
SENTRY_DSN=
