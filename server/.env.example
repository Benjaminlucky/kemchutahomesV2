# Copy this file to .env for local development. In staging/production, set
# these as environment variables in your host's dashboard (Railway → each
# service → Variables tab) instead of committing a .env file there.
#
# NEVER commit a real .env. This file only holds placeholders.

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Rotate the password in Atlas, then paste
# the new URI here (Database Access → Edit user → Autogenerate/Set password).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs access/refresh tokens. Must be a long random string, NOT a word.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Node environment. Controls cookie Secure flag (authTokens.js) and Sentry
# environment tag. Set to "production" on the live server/worker.
NODE_ENV=development

# Cookie domain for auth cookies, e.g. ".kemchutahomesltd.com" (leading dot
# so it's shared across app./www./bare domain). Leave unset for local dev —
# authTokens.js defaults to undefined, which scopes the cookie to localhost.
COOKIE_DOMAIN=

# Gates POST /api/admin/signup (requireInviteToken middleware). Unset =
# endpoint always returns 403 (safe default — use scripts/seedAdmin.js to
# create the first admin instead). Only set this temporarily, out-of-band,
# when you need to invite a new admin, then unset/rotate it again.
# Generate with: openssl rand -hex 24
ADMIN_INVITE_TOKEN=

# Used by scripts/seedAdmin.js (npm run seed:admin or node scripts/seedAdmin.js)
# to create the first admin account without going through the API at all.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── Cloudinary (media uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
RESEND_API_KEY=

# ── SMS (Termii) ─────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic

# ── AI chat (Groq) ───────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Next.js integration ──────────────────────────────────────────────────────
# Base URL of the Next.js app, used to call POST /api/revalidate after
# estate/branch/knowledge-base writes.
NEXTJS_REVALIDATE_URL=http://localhost:3000

# Shared secret for that call — must match REVALIDATE_SECRET in client's
# .env.local / hosting env vars exactly.
# Generate with: openssl rand -hex 24
REVALIDATE_SECRET=

# Where the public site is linked from in emails/SMS (password reset links,
# receipts, etc). Defaults to https://kemchutahomesltd.com if unset.
FRONTEND_URL=https://kemchutahomesltd.com

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN for this service (server API). Leave unset locally — Sentry
# no-ops with tracesSampleRate 0 when this is empty. Use a DIFFERENT DSN (or
# at least a distinguishable one) from the worker and from the client so
# errors are attributable to the right service in the Sentry dashboard.
SENTRY_DSN=

# ── Server ───────────────────────────────────────────────────────────────────
# Railway/most hosts inject this automatically — usually leave unset.
PORT=4000
